{
  "compilerOptions": {
    "declaration": true,
    "strict": true,
    "module": "NodeNext",
    "target": "ES2018",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "outDir": "./dist/",
    "rootDir": "./src",
    "sourceMap": true,
    "paths": {
      "*": ["./src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*Test.*"
  ]
}
